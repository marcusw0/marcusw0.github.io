---
import { getCollection } from 'astro:content';
import { Github } from 'lucide-astro';
import BaseLayout from '@/components/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import SectionHeader from '@/components/SectionHeader.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Software Projects | Marcus Whited" description="Go projects exploring developer tools, concurrent service checks, HTTP over TCP, interpreters, and bytecode compilation.">
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <SectionHeader
      eyebrow="Built in Go"
      title="Software Projects"
      description="I build tools I can use and systems that help me understand how software works. These projects explore concurrent services, network protocols, and language implementation."
    />

    <section aria-labelledby="selected-projects-heading">
      <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 id="selected-projects-heading" class="text-2xl font-bold text-(--text)">Selected work</h2>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-(--muted)">Explore the implementation, design decisions, and tests behind each project.</p>
        </div>
        <a href="https://github.com/marcusw0" rel="noreferrer" class="inline-flex w-fit shrink-0 items-center gap-2 text-sm font-semibold text-(--accent-strong) hover:text-(--text)">
          <Github class="h-4 w-4" aria-hidden="true" />
          View GitHub profile
        </a>
      </div>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <aside class="mt-12 rounded-lg border border-(--border) bg-(--surface) p-6" aria-labelledby="engineering-at-work-heading">
      <h2 id="engineering-at-work-heading" class="text-xl font-semibold text-(--text)">Software engineering at work</h2>
      <p class="mt-3 max-w-3xl text-sm leading-7 text-(--muted)">At work, I build Go and Python tools to automate infrastructure and security tasks. I also develop internal web applications that help teams find the service information they need.</p>
      <a href="/career/" class="mt-4 inline-flex text-sm font-semibold text-(--accent-strong) hover:text-(--text)">Explore my experience <span aria-hidden="true">&nbsp;→</span></a>
    </aside>
  </section>
</BaseLayout>
