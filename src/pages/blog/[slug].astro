---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/components/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | Marcus Whited`} description={post.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:px-8">
    <a href="/blog/" class="text-sm font-semibold text-[var(--accent-strong)] hover:text-[var(--text)]">Back to blog</a>
    <header class="mt-6 border-b border-[var(--border)] pb-8">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[var(--accent-strong)]">{post.data.date.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
      <h1 class="mt-3 text-4xl font-bold tracking-[0] text-[var(--text)]">{post.data.title}</h1>
      <p class="mt-4 text-lg leading-8 text-[var(--muted)]">{post.data.description}</p>
    </header>
    <div class="prose-tech mt-8">
      <Content />
    </div>
  </article>
</BaseLayout>
