---
import BaseLayout from '@/components/BaseLayout.astro';
---

<BaseLayout title="Page not found | Marcus Whited" description="The requested page could not be found." robots="noindex, follow">
  <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-(--accent-strong)">404</p>
    <h1 class="mt-3 text-4xl font-bold text-(--text)">Page not found</h1>
    <p class="mx-auto mt-4 max-w-xl leading-7 text-(--muted)">That page isn't here. The link may be old, or there may be a typo in the address.</p>
    <a href="/" class="mt-8 inline-flex rounded-md bg-(--accent) px-4 py-2.5 text-sm font-semibold text-(--accent-contrast) hover:bg-(--accent-strong) hover:text-(--accent-hover-contrast)">Head home</a>
  </section>
</BaseLayout>
