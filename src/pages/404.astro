---
import BaseLayout from '@/components/BaseLayout.astro';
---

<BaseLayout title="Page not found | Marcus Whited" description="The requested page could not be found." robots="noindex, follow">
  <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[var(--accent-strong)]">404</p>
    <h1 class="mt-3 text-4xl font-bold text-[var(--text)]">Page not found</h1>
    <p class="mx-auto mt-4 max-w-xl leading-7 text-[var(--muted)]">The page may have moved or the address may be incorrect.</p>
    <a href="/" class="mt-8 inline-flex rounded-md bg-[var(--accent)] px-4 py-2.5 text-sm font-semibold text-[var(--accent-contrast)] hover:bg-[var(--accent-strong)] hover:text-[var(--accent-hover-contrast)]">Return home</a>
  </section>
</BaseLayout>
