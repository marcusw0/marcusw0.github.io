---
import { getCollection } from 'astro:content';
import { BriefcaseBusiness, Code2, FileText, GitBranch, Network, Server, ShieldCheck } from 'lucide-astro';
import BaseLayout from '@/components/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';

const featuredProjects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order);

const features = [
  { href: '/projects/', title: 'Projects', description: 'Go tools, protocol implementations, and language internals, with source code and tests.', icon: BriefcaseBusiness },
  { href: '/homelab/', title: 'Homelab', description: 'The architecture, networking, and decisions behind my lab.', icon: Server },
  { href: '/career/', title: 'Career', description: 'My path through systems administration, network engineering, and software development.', icon: FileText },
];

const strengths = [
  { title: 'Software development', skills: ['Go', 'Python', 'Concurrency', 'Testing'], icon: Code2 },
  { title: 'Network engineering', skills: ['Load balancing', 'HTTP', 'TCP', 'TLS', 'DNS'], icon: Network },
  { title: 'Security & access', skills: ['Authentication', 'Access control', 'Firewalls'], icon: ShieldCheck },
  { title: 'Infrastructure & delivery', skills: ['Terraform', 'Ansible', 'GitLab CI/CD', 'Linux'], icon: GitBranch },
];

const targetRoles = ['Networking software', 'Infrastructure engineering', 'Backend services', 'Developer tooling'];
---

<BaseLayout
  title="Marcus Whited | Go, Python & Network Engineering"
  description="I build tools in Go and Python, troubleshoot network services, and automate infrastructure. My projects and experience in networking, security, and systems administration."
>
  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1.2fr_0.8fr] lg:px-8 lg:py-24">
    <div>
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.16em] text-(--accent-strong)">Go & Python Developer · Network Engineer</p>
      <h1 class="max-w-4xl text-4xl font-bold tracking-normal text-(--text) sm:text-6xl">Marcus Whited</h1>
      <p class="mt-5 text-2xl font-semibold leading-snug text-(--text)">I build tools in Go and Python.</p>
      <p class="mt-6 max-w-3xl text-base leading-8 text-(--muted)">
        My background is in networking, security, and systems administration. In my current role, I troubleshoot network services and write software to automate tasks like server updates and security blocklist changes. I also teach other teams Python, Git, and CI/CD to help them build their own automation.
      </p>
      <p class="mt-4 max-w-3xl text-base leading-8 text-(--muted)">
        Building software is the direction I want to take my career. Outside work, I build terminal tools, run a homelab, and use projects like an HTTP server and a programming language interpreter to learn more about how software works.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/projects/" class="rounded-md bg-(--accent) px-4 py-2.5 text-sm font-semibold text-(--accent-contrast) hover:bg-(--accent-strong) hover:text-(--accent-hover-contrast)">View projects</a>
        <a href="/career/" class="rounded-md border border-(--border) px-4 py-2.5 text-sm font-semibold text-(--text) hover:border-(--accent) hover:bg-(--surface)">Explore my experience</a>
      </div>
    </div>
    <aside class="rounded-lg border border-(--border) bg-(--surface) p-5 shadow-sm" aria-labelledby="strengths-heading">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-(--accent-strong)">What I work with</p>
      <h2 id="strengths-heading" class="mt-2 text-xl font-semibold text-(--text)">Software, networks, and infrastructure</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-1">
        {
          strengths.map(({ title, skills, icon: Icon }) => (
            <div class="flex gap-3">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-(--surface-strong) text-(--accent-strong)">
                <Icon class="h-4 w-4" aria-hidden="true" />
              </span>
              <div>
                <h3 class="text-sm font-semibold text-(--text)">{title}</h3>
                <p class="mt-1 text-sm leading-6 text-(--muted)">{skills.join(' · ')}</p>
              </div>
            </div>
          ))
        }
      </div>
      <div class="mt-6 border-t border-(--border) pt-5">
        <p class="flex items-center gap-2 text-sm font-semibold text-(--text)">
          <span class="h-2 w-2 rounded-full bg-(--accent)" aria-hidden="true"></span>
          Open to new opportunities
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          {targetRoles.map((role) => <span class="rounded-md border border-(--border) px-2.5 py-1.5 text-xs text-(--muted)">{role}</span>)}
        </div>
        <a href="/contact/" class="mt-4 inline-flex text-sm font-semibold text-(--accent-strong) hover:text-(--text)">Get in touch <span aria-hidden="true">&nbsp;→</span></a>
      </div>
    </aside>
  </section>

  <section class="border-y border-(--border) bg-(--surface-strong)/45" aria-labelledby="featured-projects-heading">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-(--accent-strong)">Selected work</p>
          <h2 id="featured-projects-heading" class="mt-3 text-3xl font-bold text-(--text)">Software I’m building</h2>
        </div>
        <a href="/projects/" class="text-sm font-semibold text-(--accent-strong) hover:text-(--text)">All projects</a>
      </div>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8" aria-label="Explore the site">
    <div class="grid gap-4 md:grid-cols-3">
      {
        features.map(({ href, title, description, icon: Icon }) => (
          <a href={href} class="rounded-lg border border-(--border) bg-(--surface) p-5 hover:-translate-y-0.5 hover:border-(--accent)">
            <Icon class="h-5 w-5 text-(--accent-strong)" aria-hidden="true" />
            <h2 class="mt-4 text-lg font-semibold text-(--text)">{title}</h2>
            <p class="mt-2 text-sm leading-6 text-(--muted)">{description}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
