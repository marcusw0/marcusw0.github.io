---
import BaseLayout from '@/components/BaseLayout.astro';
import { Mail, MapPin } from 'lucide-astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { careerCredentials, careerEducation, careerExperience, skillGroups } from '@/lib/career';
---

<BaseLayout title="Career | Marcus Whited" description="My experience in software development, network engineering, security, and systems administration.">
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <SectionHeader
      eyebrow="Experience & skills"
      title="My Career So Far"
      description="I started in military communications and systems administration, then worked on city networks and federal services. I now build tools in Go and Python alongside my networking and security work."
    />
    <div class="mb-8 flex flex-wrap gap-4 text-sm text-(--muted)">
      <span class="inline-flex items-center gap-2"><MapPin class="h-4 w-4" aria-hidden="true" /> Parkersburg, West Virginia</span>
      <a href="mailto:mawhited@marcuswhited.tech" class="inline-flex items-center gap-2 text-(--accent-strong) hover:text-(--text)"><Mail class="h-4 w-4" aria-hidden="true" /> mawhited@marcuswhited.tech</a>
    </div>
    <div class="grid gap-10 lg:grid-cols-[1fr_320px]">
      <div class="relative border-l border-(--border) pl-6">
        {
          careerExperience.map((item) => (
            <article class="relative mb-8 rounded-lg border border-(--border) bg-(--surface) p-5">
              <span class="absolute -left-7.75 top-6 h-3 w-3 rounded-full border-2 border-(--bg) bg-(--accent)"></span>
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-(--accent-strong)">{item.period}</p>
              <h2 class="mt-2 text-xl font-semibold text-(--text)">{item.title} · {item.timelineOrganization}</h2>
              {item.focus && <p class="mt-1 text-sm font-medium text-(--accent-strong)">{item.focus}</p>}
              <p class="mt-3 text-sm leading-6 text-(--muted)">{item.summary}</p>
              <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-6 text-(--muted)">
                {item.points.map((point) => <li>{point}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
      <aside class="space-y-5">
        <div class="rounded-lg border border-(--border) bg-(--surface) p-5">
          <h2 class="font-semibold text-(--text)">Skills</h2>
          <div class="mt-4 space-y-5">
            {skillGroups.map((group) => (
              <div>
                <h3 class="text-sm font-medium text-(--accent-strong)">{group.title}</h3>
                <div class="mt-2 flex flex-wrap gap-2">{group.skills.map((skill) => <span class="rounded-md border border-(--border) px-2 py-1 text-xs text-(--muted)">{skill}</span>)}</div>
              </div>
            ))}
          </div>
        </div>
        <div class="rounded-lg border border-(--border) bg-(--surface) p-5">
          <h2 class="font-semibold text-(--text)">Certification & Training</h2>
          <ul class="mt-4 space-y-2 text-sm leading-6 text-(--muted)">{careerCredentials.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="rounded-lg border border-(--border) bg-(--surface) p-5">
          <h2 class="font-semibold text-(--text)">Education</h2>
          <p class="mt-3 text-sm leading-6 text-(--muted)">{careerEducation}</p>
        </div>
        <div class="rounded-lg border border-(--border) bg-(--surface) p-5">
          <h2 class="font-semibold text-(--text)">See the code</h2>
          <p class="mt-3 text-sm leading-6 text-(--muted)">Outside work, I build Go tools and learn more about network protocols, interpreters, and compilers.</p>
          <a href="/projects/" class="mt-4 inline-flex text-sm font-semibold text-(--accent-strong) hover:text-(--text)">View software projects <span aria-hidden="true">&nbsp;→</span></a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
