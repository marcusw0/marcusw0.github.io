---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/BaseLayout.astro';
import Card from '@/components/Card.astro';
import SectionHeader from '@/components/SectionHeader.astro';

const docs = (await getCollection('homelab')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Homelab | Marcus Whited" description="How I build and run my homelab, including its services, networking, authentication, and ongoing improvements.">
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <SectionHeader
      eyebrow="Under the hood"
      title="Homelab"
      description="I use my homelab to try out tools and learn by running them. These pages cover how I connect the services, manage access, and plan for recovery, along with the work I am still finishing."
    />
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        docs.map((doc) => (
          <Card
            href={`/homelab/${doc.id}/`}
            title={doc.data.title}
            description={doc.data.description}
            meta={doc.data.section}
            tags={doc.data.tags}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
