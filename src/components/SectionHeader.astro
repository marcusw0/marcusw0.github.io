---
type Props = {
  eyebrow?: string;
  title: string;
  description?: string;
};

const { eyebrow, title, description } = Astro.props;
---

<div class="mb-8 max-w-3xl">
  {eyebrow && <p class="mb-3 text-sm font-semibold uppercase tracking-[0.16em] text-[var(--accent-strong)]">{eyebrow}</p>}
  <h1 class="text-3xl font-bold tracking-[0] text-[var(--text)] sm:text-4xl">{title}</h1>
  {description && <p class="mt-4 text-base leading-7 text-[var(--muted)]">{description}</p>}
</div>
