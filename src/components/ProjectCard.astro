---
import { Github } from 'lucide-astro';
import type { CollectionEntry } from 'astro:content';

type Props = {
  project: CollectionEntry<'projects'>;
};

const { project } = Astro.props;
const href = `/projects/${project.id}/`;
const titleId = `project-${project.id}-title`;
---

<article class="group relative flex h-full cursor-pointer flex-col rounded-lg border border-(--border) bg-(--surface) p-5 shadow-sm transition-[border-color,transform] duration-150 hover:-translate-y-0.5 hover:border-(--accent)">
  <a href={href} class="absolute inset-0 z-0 rounded-lg" aria-labelledby={titleId}></a>
  <div class="pointer-events-none relative z-10 flex-1">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-(--accent-strong)">{project.data.date.getFullYear()}</p>
    <h2 id={titleId} class="mt-3 text-xl font-semibold tracking-normal text-(--text) group-hover:text-(--accent-strong)">
      {project.data.title}
    </h2>
    <p class="mt-3 text-sm leading-6 text-(--muted)">{project.data.description}</p>
    <div class="mt-5 flex flex-wrap gap-2">
      {project.data.tech.map((tech) => <span class="rounded-md border border-(--border) px-2 py-1 text-xs text-(--muted)">{tech}</span>)}
    </div>
  </div>
  <div class="pointer-events-none relative z-10 mt-6 flex items-center justify-between gap-3 border-t border-(--border) pt-4">
    <span class="text-sm font-semibold text-(--accent-strong) group-hover:text-(--text)">View project</span>
    {
      project.data.github && (
        <a href={project.data.github} class="pointer-events-auto relative z-20 inline-flex h-9 w-9 items-center justify-center rounded-md border border-(--border) text-(--muted) hover:border-(--accent) hover:text-(--text)" aria-label={`${project.data.title} GitHub repository`}>
          <Github class="h-4 w-4" />
        </a>
      )
    }
  </div>
</article>
