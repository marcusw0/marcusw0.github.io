---
import { Moon, Sun } from 'lucide-astro';
---

<button
  id="theme-toggle"
  type="button"
  class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-[var(--border)] bg-[var(--surface)] text-[var(--muted)] hover:border-[var(--accent)] hover:text-[var(--text)]"
  aria-label="Toggle color theme"
  aria-pressed="true"
>
  <Sun class="hidden h-4 w-4 dark:block" aria-hidden="true" />
  <Moon class="h-4 w-4 dark:hidden" aria-hidden="true" />
</button>

<script is:inline>
  const toggle = document.getElementById('theme-toggle');

  const syncToggle = () => {
    const isDark = document.documentElement.classList.contains('dark');
    toggle?.setAttribute('aria-pressed', String(isDark));
    toggle?.setAttribute('aria-label', `Switch to ${isDark ? 'light' : 'dark'} theme`);
  };

  syncToggle();
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const nextTheme = root.classList.contains('dark') ? 'light' : 'dark';
    root.classList.toggle('dark', nextTheme === 'dark');
    localStorage.setItem('theme', nextTheme);
    syncToggle();
    window.dispatchEvent(new Event('themechange'));
  });
</script>
