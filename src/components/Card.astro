---
type Props = {
  href?: string;
  title: string;
  description: string;
  meta?: string;
  tags?: string[];
};

const { href, title, description, meta, tags = [] } = Astro.props;
const Element = href ? 'a' : 'article';
---

<Element
  href={href}
  class="group block rounded-lg border border-[var(--border)] bg-[var(--surface)] p-5 shadow-sm hover:-translate-y-0.5 hover:border-[var(--accent)]"
>
  {meta && <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--accent-strong)]">{meta}</p>}
  <h2 class="text-lg font-semibold tracking-[0] text-[var(--text)] group-hover:text-[var(--accent-strong)]">{title}</h2>
  <p class="mt-3 text-sm leading-6 text-[var(--muted)]">{description}</p>
  {
    tags.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="rounded-md border border-[var(--border)] px-2 py-1 text-xs text-[var(--muted)]">{tag}</span>
        ))}
      </div>
    )
  }
</Element>
