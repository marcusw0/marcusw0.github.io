---
type Props = {
  href?: string;
  title: string;
  description: string;
  meta?: string;
  tags?: string[];
};

const { href, title, description, meta, tags = [] } = Astro.props;
const Element = href ? 'a' : 'article';
---

<Element
  href={href}
  class="group block rounded-lg border border-(--border) bg-(--surface) p-5 shadow-sm hover:-translate-y-0.5 hover:border-(--accent)"
>
  {meta && <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-(--accent-strong)">{meta}</p>}
  <h2 class="text-lg font-semibold tracking-normal text-(--text) group-hover:text-(--accent-strong)">{title}</h2>
  <p class="mt-3 text-sm leading-6 text-(--muted)">{description}</p>
  {
    tags.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="rounded-md border border-(--border) px-2 py-1 text-xs text-(--muted)">{tag}</span>
        ))}
      </div>
    )
  }
</Element>
